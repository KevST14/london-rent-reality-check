# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.ipynb_checkpoints/

# Data — keep the folder structure, not the contents
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep
# ...except the OpenStreetMap extracts: small, redistributable (ODbL), and it
# saves anyone cloning the repo a slow trip to the Overpass API.
!data/external/osm_*.gpkg

# Secrets / config
.env
kaggle.json

# Reports
reports/figures/*
!reports/figures/.gitkeep

# osmnx's raw Overpass response cache (regenerated on demand)
cache/

# OS / editor
.DS_Store
.vscode/
.idea/
