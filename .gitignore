# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.ipynb_checkpoints/

# Data: keep the folder structure, not the contents
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep
# ...except a few small, redistributable files the repo and the deployed app need:
# the OpenStreetMap extracts (ODbL) and the borough-boundary GeoJSON.
!data/external/osm_*.gpkg
!data/raw/neighbourhoods.geojson

# Secrets / config
.env
kaggle.json

# Reports
reports/figures/*
!reports/figures/.gitkeep

# osmnx's raw Overpass response cache (regenerated on demand)
cache/

# OS / editor
.DS_Store
.vscode/
.idea/
